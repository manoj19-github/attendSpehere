M final_data\nWHERE 1=1\n\nAND (\n    NULL IS NULL OR\n    LOWER(full_name) LIKE LOWER(CONCAT('%', NULL, '%')) OR\n    LOWER(email) LIKE LOWER(CONCAT('%', NULL, '%')) OR\n    CAST(event_date AS TEXT) LIKE CONCAT('%', NULL, '%')\n)\n\nAND (\n    NULL IS NULL OR\n    (NULL = 'below_8' AND working_hours < 8) OR\n    (NULL = 'above_8' AND working_hours >= 8)\n)\n\n    ) AS count_query","timestamp":"2026-05-03 17:08:01"}
